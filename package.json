{
  "name": "utxowear",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run types && astro dev --force",
    "build": "bun run types && astro build",
    "test": "bun test",
    "preview": "bun run types && astro preview",
    "stripe:listen": "bunx @stripe/cli listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to http://localhost:4321/api/stripe-webhook",
    "deploy": "bun run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply utxowear-checkout --local",
    "migrate:remote": "wrangler d1 migrations apply utxowear-checkout --remote",
    "types": "wrangler types worker-configuration.d.ts",
    "astro": "astro",
    "check": "bun run types && astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@react-three/fiber": "^9.8.1",
    "@stylexjs/stylex": "^0.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "astro": "^7.3.8",
    "cannon-es": "^0.20.0",
    "effect": "3.22.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.1",
    "bun-types": "1.4.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.88.0"
  }
}
