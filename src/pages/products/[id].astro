---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../../styles/storefront.stylex';
import Storefront from '../../layouts/Storefront.astro';
import DeferredProductDetails from '../../components/DeferredProductDetails';
import ProductLoading from '../../components/ProductLoading.astro';
import { getPrintifyProducts } from '../../lib/printify';
import { env } from 'cloudflare:workers';

const products = await getPrintifyProducts(env);
const product = products.find((candidate) => candidate.id === Astro.params.id);
if (!product) Astro.response.status = 404;
const previewImage = product?.mockups[0];
---

<Storefront
  title={`${product?.title ?? 'Product not found'} — utxowear`}
  previewImage={product && previewImage ? { src: previewImage, alt: product.title } : undefined}
>
  <main {...stylex.attrs(styles.main)}>
    <div {...stylex.attrs(styles.catalogHeading)}>
      <a href="/products" {...stylex.attrs(styles.productLink)}>← All products</a>
    </div>
    {product ? (
      <DeferredProductDetails products={products} productId={product.id} client:idle>
        <ProductLoading detail reloadPath={Astro.url.pathname} />
      </DeferredProductDetails>
    ) : <h1>Product not found</h1>}
  </main>
</Storefront>
