{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["bun-types", "vite/client"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["dist", "public", "node_modules"]
}
