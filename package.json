{
  "name": "utxowear",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run types && vite dev",
    "build": "bun run types && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "stripe:listen": "bunx @stripe/cli listen --events checkout.session.completed,checkout.session.async_payment_succeeded --forward-to http://localhost:4321/api/stripe-webhook",
    "deploy": "bun run scripts/deploy.ts",
    "deploy:preview": "bun run scripts/deploy.ts preview",
    "deploy:production": "bun run scripts/deploy.ts production",
    "migrate:local": "wrangler d1 migrations apply CHECKOUT_DB --local --config wrangler.jsonc",
    "migrate:preview": "wrangler d1 migrations apply CHECKOUT_DB --remote --env preview --config wrangler.jsonc",
    "migrate:production": "wrangler d1 migrations apply CHECKOUT_DB --remote --env production --config wrangler.jsonc",
    "types": "wrangler types worker-configuration.d.ts",
    "check": "bun run types && tsc --noEmit",
    "verify": "bun run lint && bun run format:check && bun run check && bun run test",
    "prepare": "[ ! -e .git ] || (git config core.hooksPath .githooks && git config fetch.prune true)",
    "submit": "git push --set-upstream origin HEAD && gh pr create --base trunk --fill && gh pr merge --auto --merge",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.8.1",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "cannon-es": "^0.20.0",
    "effect": "3.22.2",
    "gsap": "^3.15.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.1",
    "three": "^0.185.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@playwright/test": "^1.64.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-types": "1.4.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.88.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.1"
  }
}
