# Copy to .dev.vars for local development. Never commit live credentials.
PRINTIFY_API_TOKEN=
# Shared signing secret for Printify product publication webhooks.
PRINTIFY_WEBHOOK_SECRET=
PRINTIFY_SHOP_ID=
PRINTIFY_STORE_URL=https://utxowear.printify.me/
# Customer checkout currency: USD or EUR. Printify Pop-Up source prices remain USD.
PRINTIFY_CURRENCY=USD
# Required for EUR: merchant-maintained EUR per 1 USD, positive, up to 6 decimals.
# Applies to both product retail prices and shipping. No default exchange rate.
PRINTIFY_USD_TO_EUR_RATE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The public HTTPS origin for Stripe success/cancel URLs (localhost for development).
CHECKOUT_ORIGIN=http://localhost:4321
