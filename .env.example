# Optional: enables the official Printify API and returns every generated mockup.
# Create a token in Printify under My Profile > Connections.
PRINTIFY_API_TOKEN=

# Optional when the account has multiple shops. Without it, the integration
# matches the shop title to "utxowear" and then falls back to the first shop.
PRINTIFY_SHOP_ID=

PRINTIFY_STORE_URL=https://utxowear.printify.me/
PRINTIFY_CURRENCY=EUR
