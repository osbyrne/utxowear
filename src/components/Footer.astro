---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
---

<footer id="about" {...stylex.attrs(styles.footer)}>
  <div {...stylex.attrs(styles.footerRow)}>
    <p {...stylex.attrs(styles.footerBrand)}>utxowear</p>
    <div {...stylex.attrs(styles.copyright)}>
      <a href="/3d-shirt" {...stylex.attrs(styles.productLink)}>3D shirt</a>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
