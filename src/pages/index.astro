---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShirtMount from '../components/ShirtMount.svelte';
import ProductList from '../components/ProductList.astro';
import { getPrintifyProducts } from '../lib/printify';
import '../app.css';

const products = await getPrintifyProducts();
---

<html lang="en" data-theme="corporate">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/icon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>utxowear</title>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <div class="mx-auto min-h-screen w-full max-w-[1600px] bg-base-100 shadow-2xl xl:my-6 xl:min-h-[calc(100vh-3rem)] xl:overflow-hidden xl:rounded-3xl xl:ring-1 xl:ring-base-300/60">
      <Header />

      <main class="grid gap-8 px-4 py-6 sm:px-6 sm:py-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(22rem,0.75fr)] lg:gap-10 lg:px-10 lg:py-10 xl:gap-14 xl:px-14">
        <section class="min-w-0" aria-labelledby="featured-heading">
          <div class="mb-5 max-w-2xl sm:mb-6">
            <p class="text-xs font-bold uppercase tracking-[0.3em] text-primary">UTXOWEAR / 001</p>
            <h1 id="featured-heading" class="mt-2 text-3xl font-black tracking-tight sm:text-4xl xl:text-5xl">
              Built for the next block.
            </h1>
            <p class="mt-3 max-w-xl text-sm leading-6 text-base-content/70 sm:text-base">
              Heavyweight essentials inspired by Bitcoin's most durable primitive. Drag the fabric
              to explore the first release.
            </p>
          </div>

          <ShirtMount client:load />
        </section>

        <section id="shop" class="min-w-0 lg:pt-1" aria-labelledby="shop-heading">
          <div class="mb-5 flex items-end justify-between gap-4 border-b border-base-300 pb-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Collection 01</p>
              <h2 id="shop-heading" class="mt-1 text-2xl font-black tracking-tight">Shop the drop</h2>
            </div>
            <span class="shrink-0 text-sm text-base-content/60">
              {products.length} {products.length === 1 ? 'piece' : 'pieces'}
            </span>
          </div>

          <ProductList products={products} />
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
