---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
---

<header {...stylex.attrs(styles.header)}>
  <div {...stylex.attrs(styles.navbar)}>
    <div {...stylex.attrs(styles.brandArea)}>
      <a href="/" {...stylex.attrs(styles.brand)} aria-label="UTXOWEAR home">
        UTXOWEAR
      </a>
    </div>

    <div {...stylex.attrs(styles.actions)}>
      <button type="button" {...stylex.attrs(styles.button, styles.search)} aria-label="Search">
        Search
      </button>
      <button type="button" {...stylex.attrs(styles.button, styles.account)} aria-label="Account">
        Account
      </button>
      <button type="button" {...stylex.attrs(styles.button, styles.bag)} aria-label="Shopping bag with 0 items">
        Bag
        <span {...stylex.attrs(styles.badge)}>0</span>
      </button>
    </div>
  </div>
</header>
