---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
import Storefront from '../layouts/Storefront.astro';
import ProductList from '../components/ProductList.astro';
import ProductLoading from '../components/ProductLoading.astro';
---

<Storefront title="Products — utxowear">
  <main {...stylex.attrs(styles.main)}>
    <section aria-labelledby="products-title">
      <div {...stylex.attrs(styles.catalogHeading)}>
        <a href="/" {...stylex.attrs(styles.productLink)}>← Back</a>
        <h1 id="products-title" {...stylex.attrs(styles.pageHeading)}>All products</h1>
      </div>
      <ProductList catalog server:defer>
        <ProductLoading slot="fallback" reloadPath="/products" />
      </ProductList>
    </section>
  </main>
</Storefront>
