---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
import Storefront from '../layouts/Storefront.astro';
import ProductList from '../components/ProductList.astro';
import ProductLoading from '../components/ProductLoading.astro';
---

<Storefront>
  <main {...stylex.attrs(styles.main)}>
    <section id="shop" aria-label="Featured products">
      <ProductList server:defer>
        <ProductLoading slot="fallback" reloadPath="/" />
      </ProductList>
    </section>
  </main>
</Storefront>
