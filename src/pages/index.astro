---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shirt from '../components/Shirt.tsx';
import ProductList from '../components/ProductList.astro';
import { getPrintifyProducts } from '../lib/printify';
import '../app.css';

const products = await getPrintifyProducts();
---

<html lang="en" data-theme="corporate">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/icon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>utxowear</title>
  </head>
  <body class="min-h-screen bg-base-200 text-base-content">
    <div class="mx-auto min-h-screen w-full max-w-[1600px] bg-base-100 shadow-2xl xl:my-6 xl:min-h-[calc(100vh-3rem)] xl:overflow-hidden xl:rounded-3xl xl:ring-1 xl:ring-base-300/60">
      <Header />

      <main class="grid gap-8 px-4 py-6 sm:px-6 sm:py-8 lg:grid-cols-[minmax(0,1.25fr)_minmax(22rem,0.75fr)] lg:gap-10 lg:px-10 lg:py-10 xl:gap-14 xl:px-14">

        <section class="min-w-0" aria-label="React product preview">
          <Shirt client:load />
        </section>

        <section id="shop" class="min-w-0 lg:pt-1" aria-label="Shop">
          <div class="mb-5 flex justify-end border-b border-base-300 pb-4">
            <span class="shrink-0 text-sm text-base-content/60">
              {products.length} {products.length === 1 ? 'piece' : 'pieces'}
            </span>
          </div>

          <ProductList products={products} />
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
