---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Shirt from '../components/Shirt.tsx';
import ProductList from '../components/ProductList.astro';
import { getPrintifyProducts } from '../lib/printify';
import { env } from 'cloudflare:workers';
import '../app.css';

const products = await getPrintifyProducts(env);
---

<html lang="en">
  <head>
    <!-- Establish reset precedence before development StyleX CSS loads. -->
    <style is:inline>@layer reset;</style>
    <meta charset="utf-8" />
    <link rel="icon" href="/icon.webp" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>utxowear</title>
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    <script>
      if (import.meta.env.DEV) {
        import('virtual:stylex:css-only');
      }
    </script>
  </head>
  <body {...stylex.attrs(styles.body)}>
    <div {...stylex.attrs(styles.shell)}>
      <Header />

      <main {...stylex.attrs(styles.main)}>

        <section {...stylex.attrs(styles.preview)} aria-label="React product preview">
          <Shirt client:load />
        </section>

        <section id="shop" {...stylex.attrs(styles.shop)} aria-label="Shop">
          <div {...stylex.attrs(styles.countRow)}>
            <span {...stylex.attrs(styles.count)}>
              {products.length} {products.length === 1 ? 'piece' : 'pieces'}
            </span>
          </div>

          <ProductList products={products} />
        </section>
      </main>

      <Footer />
    </div>
  </body>
</html>
