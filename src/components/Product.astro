---
import * as stylex from '@stylexjs/stylex';
import { styles, productMarker } from '../styles/storefront.stylex';
import type { StoreProduct } from '../lib/printify';

type Props = {
  product: StoreProduct;
};

const { product } = Astro.props;
const price = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: product.currency,
}).format(product.price / 100);
---

<article {...stylex.attrs(styles.card, productMarker)}>
  <a href={product.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${product.title} on Printify`}>
    <figure {...stylex.attrs(styles.figure)}>
      <img
        src={product.mockups[0]}
        alt={`${product.title} product mockup`}
        loading="lazy"
        {...stylex.attrs(styles.image)}
      />
    </figure>
  </a>
  <div {...stylex.attrs(styles.productBody)}>
    <div {...stylex.attrs(styles.productHeading)}>
      <h3 {...stylex.attrs(styles.productTitle)}>
        <a href={product.href} target="_blank" rel="noopener noreferrer" {...stylex.attrs(styles.productLink)}>
          {product.title}
        </a>
      </h3>
      <span {...stylex.attrs(styles.price)}>{price}</span>
    </div>
    <p {...stylex.attrs(styles.description)}>
      {product.description || 'Printify-made / unisex fit'}
    </p>
  </div>
</article>
