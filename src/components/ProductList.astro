---
import Checkout from './Checkout';
import { getPrintifyProducts } from '../lib/printify';
import { env } from 'cloudflare:workers';
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';

type Props = {
  catalog?: boolean;
};

const { catalog = false } = Astro.props;
const products = await getPrintifyProducts(env).catch(() => null);
---

{products ? (
  <Checkout products={products} catalog={catalog} client:load />
) : (
  <p role="alert" {...stylex.attrs(styles.error)}>
    Products could not load. <a href={catalog ? '/products' : '/'}>Reload</a>
  </p>
)}
