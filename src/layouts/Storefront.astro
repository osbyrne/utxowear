---
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/storefront.stylex';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../app.css';

type Props = {
  title?: string;
  previewImage?: { src: string; alt: string };
};
const { title = 'utxowear', previewImage } = Astro.props;
const description = 'Clothing inspired by cryptography whitepapers.';
const pageUrl = new URL(Astro.url.pathname, Astro.url);
const previewImageUrl = new URL(previewImage?.src ?? '/images/link-preview.png', Astro.url);
const previewImageDescription = previewImage?.alt ?? 'Black T-shirt in front of a cryptography paper.';
---

<html lang="en">
  <head>
    <!-- Establish reset precedence before development StyleX CSS loads. -->
    <style is:inline>@layer reset;</style>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="200x200" href="/icons/light-mode-transparent.png" />
    <link rel="icon" type="image/png" sizes="200x200" href="/icons/dark-mode-transparent.png" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="utxowear" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={previewImageUrl} />
    {!previewImage && <>
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1055" />
      <meta property="og:image:height" content="1055" />
    </>}
    <meta property="og:image:alt" content={previewImageDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImageUrl} />
    <meta name="twitter:image:alt" content={previewImageDescription} />
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
    <script>
      if (import.meta.env.DEV) {
        import('virtual:stylex:css-only');
      }
    </script>
  </head>
  <body {...stylex.attrs(styles.body)}>
    <div {...stylex.attrs(styles.shell)}>
      <Header />

      <slot />

      <Footer />
    </div>
  </body>
</html>
