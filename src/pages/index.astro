---
import DemoCounter from '../components/DemoCounter.svelte';
import '../app.css';
---

<html lang="en" data-theme="corporate">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro + Svelte Demo</title>
  </head>
  <body class="min-h-screen bg-base-200">
    <main class="mx-auto flex min-h-screen w-full max-w-4xl items-center justify-center p-6">
      <section class="card w-full max-w-xl bg-base-100 shadow-2xl ring-1 ring-base-300/60">
        <div class="card-body gap-6">
          <div class="space-y-2 text-center">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">Astro + Svelte</p>
            <h1 class="text-4xl font-black tracking-tight">Interactive Demo</h1>
            <p class="text-base-content/70">Centered layout with Tailwind and DaisyUI styling.</p>
          </div>
          <DemoCounter client:load />
        </div>
      </section>
    </main>
  </body>
</html>
